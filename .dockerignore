# ==============================================================================
# OpenSourceMate .dockerignore
# Keeps build contexts clean, fast, and ensures NO SECRETS are baked into images
# ==============================================================================

# Version Control & CI
.git/
.gitignore
.gitattributes
.github/

# Environment Variables & Secrets - STRICTLY EXCLUDED
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
secrets/
*.secret

# Python artifacts & virtual environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
dist/
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Node.js & Next.js build output
node_modules/
.next/
out/
.turbo/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.storybook/
storybook-static/

# Editor & OS files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
ehthumbs.db

# Documentation, notebooks & local scripts
docs/
docs-site/
fixtures/
notebooks/
scripts/
*.md
!README.md
