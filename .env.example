# ==============================================================================
# OpenSourceMate Root Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   PowerShell: Copy-Item .env.example .env
#   Bash:       cp .env.example .env
#
# Docker Compose automatically reads from this file to configure both backend
# and frontend services. Individual settings can also be placed in backend/.env
# and frontend/.env.local.
#
# All variables default to safe local values. Zero external credentials are
# required for basic local startup and GitHub profile analysis.
# ==============================================================================

# ------------------------------------------------------------------------------
# Backend Configuration (FastAPI)
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=dev-insecure-secret-key-change-in-production

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
ALLOWED_HOSTS=["*"]

# Optional: GitHub Personal Access Token to increase rate limits (60 -> 5,000 req/hr)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=

# Optional: AI API Key for issue match explanations
AI_API_KEY=
AI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# Frontend Configuration (Next.js)
# ------------------------------------------------------------------------------
# Backend API base URL accessible from the developer's browser
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_USE_MOCKS=false
