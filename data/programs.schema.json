{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProgramsConfig",
  "type": "object",
  "required": ["version", "programs"],
  "properties": {
    "version": { "type": "string" },
    "description": { "type": "string" },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "labels", "topics"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "labels": {
            "type": "array",
            "items": { "type": "string" }
          },
          "topics": {
            "type": "array",
            "items": { "type": "string" }
          },
          "website": { "type": "string" }
        }
      }
    }
  }
}
