{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "codegen:types": "node scripts/generate-types.mjs",
    "codegen:check": "node scripts/generate-types.mjs --check",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "mock-server": "node scripts/mock-server.mjs",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.13",
    "@types/jest": "^29.5.12",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "^3.10.1",
    "tailwindcss": "^4",
    "typescript": "^7"
  }
}
